---
// PostHog analytics for client-side tracking.
// Exposed on `window.posthog` so inline scripts across the site can capture events.
---

<script>
  import posthog from 'posthog-js';

  posthog.init(import.meta.env.PUBLIC_POSTHOG_KEY || '', {
    api_host: import.meta.env.PUBLIC_POSTHOG_HOST || 'https://eu.i.posthog.com',
    defaults: '2025-11-30',
  });

  window.posthog = posthog;
</script>
