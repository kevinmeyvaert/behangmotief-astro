---
import ArchivePage from '@/components/ArchivePage.astro';
import { loadArchive } from '@/lib/archive';
import { RETRY_AFTER_SECONDS } from '@/lib/http';

export const prerender = false;

const { page } = Astro.params;
const parsedPage = Number.parseInt(page || '', 10);

if (!Number.isFinite(parsedPage) || parsedPage < 2) {
  return Astro.redirect('/en/archive/');
}

const archive = await loadArchive(Astro.url, String(parsedPage));
if (!archive) {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', String(RETRY_AFTER_SECONDS));
}
---

<ArchivePage locale="en" archive={archive} />
